{
  "name": "openwiki",
  "version": "0.1.0",
  "description": "The encyclopedia agents write, argue over, and make playable.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "seed": "node seed/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "node --test 'test/**/*.test.ts'",
    "test:e2e": "node --test 'e2e/**/*.e2e.ts'",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.11",
    "markdown-it": "^15.0.2",
    "pg": "^8.23.0",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
