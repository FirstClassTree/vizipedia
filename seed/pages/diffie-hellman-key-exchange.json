      "body": "<style>\n.df{box-sizing:border-box;max-width:1040px;margin:0 auto;font-family:var(--ow-font);color:var(--ow-fg)}\n.df *{box-sizing:border-box}\n.df-g{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.9fr) minmax(0,1fr);gap:8px 10px;align-items:stretch}\n.df-h{font-size:15px;font-weight:750;text-align:center;padding:8px 4px;border-radius:12px;background:var(--ow-panel);border:1px solid var(--ow-line)}\n.df-h.eve{background:transparent;border-style:dashed}\n.df-c{display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;gap:2px;min-height:58px;padding:8px 6px;border-radius:12px;font-family:var(--ow-mono);font-size:clamp(13px,2.6vw,17px);line-height:1.3}\n.df-c small{font-family:var(--ow-font);font-size:12px;color:var(--ow-muted)}\n.df-c.pub{background:color-mix(in oklch,oklch(0.6 0.15 250) 12%,transparent)}\n.df-c.sec{background:color-mix(in oklch,oklch(0.6 0.2 25) 12%,transparent)}\n.df-c.no{color:var(--ow-muted);font-size:clamp(18px,3.4vw,24px)}\n.df-c.win{background:var(--ow-accent);color:var(--ow-accent-ink);font-weight:700}\n.df-c.win small{color:var(--ow-accent-ink)}\n.df-c b{font-weight:800}\n.df-k{display:flex;flex-wrap:wrap;gap:8px 18px;margin:12px 0 0;font-size:13px;color:var(--ow-muted)}\n.df-k i{display:inline-block;width:12px;height:12px;border-radius:3px;margin-right:6px;vertical-align:-1px}\n</style>\n<div class=\"df\" role=\"img\" aria-label=\"Worked Diffie-Hellman example with p 23 and g 5: Alice's secret 4 and Bob's secret 3 give public values 4 and 10, and both compute the shared secret 18, which Eve never sees\">\n  <div class=\"df-g\">\n    <div class=\"df-h\">Alice</div><div class=\"df-h eve\">Eve sees</div><div class=\"df-h\">Bob</div>\n    <div class=\"df-c pub\"><span>g = 5, p = 23</span><small>agreed in public</small></div><div class=\"df-c pub\"><span>g = 5, p = 23</span></div><div class=\"df-c pub\"><span>g = 5, p = 23</span><small>agreed in public</small></div>\n    <div class=\"