{
  "title": "How Instagram ranks",
  "slug": "instagram-ranking",
  "hue": 335,
  "lede": "Instagram ranks Feed, Stories, Explore and Reels with separate systems, each weighing signals such as your own activity and a post's popularity in its own order.",
  "sections": [
    {
      "kind": "experience",
      "heading": "Which signal comes first",
      "body": "<style>\n.ig{font-family:var(--ow-font);color:var(--ow-fg);font-size:16px;line-height:1.45;max-width:1100px;margin:0 auto;-webkit-font-smoothing:antialiased}\n.ig *{box-sizing:border-box}\n.ig h3{margin:0;font-size:13px;font-weight:650;letter-spacing:.06em;text-transform:uppercase;color:var(--ow-muted)}\n.ask{margin:0 0 12px;font-size:17px;font-weight:600}\n.ask span{color:var(--ow-muted);font-weight:400}\n.seg{display:grid;grid-template-columns:repeat(4,1fr);gap:4px;padding:4px;border:1px solid var(--ow-line);border-radius:14px;background:var(--ow-panel)}\n.seg button{appearance:none;border:0;margin:0;min-height:46px;border-radius:10px;background:transparent;color:var(--ow-fg);font:inherit;font-size:16px;font-weight:600;cursor:pointer;touch-action:manipulation;transition:background-color .2s,color .2s}\n.seg button:hover{background:color-mix(in oklch,var(--ow-accent) 9%,transparent)}\n.seg button[aria-checked=\"true\"]{background:var(--ow-accent);color:var(--ow-accent-ink)}\n.seg button:focus-visible{outline:2px solid var(--ow-accent);outline-offset:2px}\n.grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);gap:20px;margin-top:18px}\n.head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:10px;min-height:20px}\n.list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}\n.card{display:grid;grid-template-columns:34px minmax(0,1fr);gap:12px;align-items:start;padding:12px 14px;border:1px solid var(--ow-line);border-radius:12px;background:var(--ow-panel);will-change:transform}\n.card[hidden]{display:none}\n.n{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;border:1px solid var(--ow-line);font-family:var(--ow-mono);font-size:15px;font-weight:600;color:var(--ow-muted)}\n.t{display:block;font-weight:650;font-size:16px}\n.d{display:block;color:var(--ow-muted);font-size:15px;margin-top:2px}\n.top1{border-color:var(--ow-accent);background:color-mix(in oklch,var(--ow-accent) 7%,var(--ow-panel));box-shadow:0 0 0 1px var(--ow-accent) inset}\n.top1 .n{background:var(--ow-accent);border-color:var(--ow-accent);color:var(--ow-accent-ink)}\n.badge{display:inline-block;margin-left:8px;padding:1px 8px;border-radius:99px;background:var(--ow-accent);color:var(--ow-accent-ink);font-size:12px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;vertical-align:2px}\n.unranked .n{border-style:dashed}\n.side{display:flex;flex-direction:column;gap:12px}\n.blk{border:1px solid var(--ow-line);border-radius:12px;background:var(--ow-panel);padding:14px}\n.blk p{margin:8px 0 0;font-size:15px;color:var(--ow-fg)}\n.pool{display:flex;gap:6px;margin-top:10px}\n.pool span{flex:1;text-align:center;padding:7px 6px;border-radius:9px;border:1px dashed var(--ow-line);color:var(--ow-muted);font-size:14px;font-weight:600;transition:background-color .25s,color .25s,border-color .25s}\n.pool span.on{border:1px solid var(--ow-accent);background:color-mix(in oklch,var(--ow-accent) 12%,var(--ow-panel));color:var(--ow-fg)}\n.pool span.on::before{content:\"\\2713\\00a0\";color:var(--ow-accent);font-weight:700}\n.chips{list-style:none;margin:10px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:6px}\n.chips li{padding:5px 10px;border-radius:99px;border:1px solid var(--ow-line);font-size:15px;background:var(--ow-bg)}\n.note{margin:14px 0 0;font-size:14px;color:var(--ow-muted)}\n@media (max-width:720px){.grid{grid-template-columns:minmax(0,1fr);gap:14px}.side{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px}}\n@media (max-width:520px){.side{grid-template-columns:minmax(0,1fr)}.ask{font-size:16px}.seg button{font-size:15px}.card{padding:11px 12px;gap:10px}}\n@media (prefers-reduced-motion:reduce){.seg button,.pool span{transition:none}}\n</style>\n<div class=\"ig\">\n  <p class=\"ask\">Pick a surface. <span>The signals reorder the way Instagram ranks them there.</span></p>\n  <div class=\"seg\" role=\"radiogroup\" aria-label=\"Instagram surface\">\n    <button type=\"button\" role=\"radio\" data-s=\"feed\">Feed</button>\n    <button type=\"button\" role=\"radio\" data-s=\"stories\">Stories</button>\n    <button type=\"button\" role=\"radio\" data-s=\"explore\">Explore</button>\n    <button type=\"button\" role=\"radio\" data-s=\"reels\">Reels</button>\n  </div>\n  <div class=\"grid\">\n    <section aria-labelledby=\"kicker\">\n      <div class=\"head\"><h3 id=\"kicker\">Ranked, roughly by importance</h3></div>\n      <ol class=\"list\" id=\"list\" aria-live=\"polite\"></ol>\n    </section>\n    <aside class=\"side\">\n      <div class=\"blk\">\n        <h3>Where the posts come from</h3>\n        <div class=\"pool\" aria-hidden=\"true\"><span id=\"pf\">You follow</span><span id=\"pn\">You don't follow</span></div>\n        <p id=\"pool\"></p>\n      </div>\n      <div class=\"blk\">\n        <h3>Actions it predicts most</h3>\n        <ul class=\"chips\" id=\"acts\"></ul>\n      </div>\n    </aside>\n  </div>\n  <p class=\"note\" id=\"note\"></p>\n</div>\n<script>\n(function () {\n  var SIGNALS = {\n    activity: \"Your activity\",\n    post: \"Information about the post\",\n    poster: \"Information about the person who posted\",\n    history: \"Your history with the person who posted\",\n    viewing: \"Viewing history\",\n    engagement: \"Engagement history\",\n    closeness: \"Closeness\"\n  };\n  var SURFACES = {\n    feed: {\n      ranked: true,\n      order: [\n        [\"activity\", \"Posts you've liked, shared, saved or commented on.\"],\n        [\"post\", \"How popular it is and how fast it gathers likes, plus when and where it was posted.\"],\n        [\"poster\", \"How often people have interacted with them in the past few weeks.\"],\n        [\"history\", \"How interested you are in their posts, like whether you comment on each other's.\"]\n      ],\n      follow: true, notFollow: true,\n      pool: \"Accounts you follow, recommended posts from accounts you don't, and ads.\",\n      acts: [\"Spend a few seconds\", \"Comment\", \"Like\", \"Share\", \"Tap the profile photo\"],\n      note: \"Source: Instagram, Instagram Ranking Explained, May 2023.\"\n    },\n    stories: {\n      ranked: false,\n      order: [\n        [\"viewing\", \"How often you view an account's stories.\"],\n        [\"engagement\", \"How often you engage with its stories, like sending a like or a DM.\"],\n        [\"closeness\", \"Your relationship with the author, and how likely you are friends or family.\"]\n      ],\n      follow: true, notFollow: false,\n      pool: \"Accounts you follow, plus ads.\",\n      acts: [\"Tap into a story\", \"Reply\", \"Move on to the next\"],\n      note: \"For Stories Instagram lists these signals without an order of importance, so none is ranked first.\"\n    },\n    explore: {\n      ranked: true,\n      order: [\n        [\"post\", \"How many people like, comment, share and save it, and how fast. This counts much more here than in Feed or Stories.\"],\n        [\"activity\", \"What you've liked, saved, shared or commented on, and how you've used Explore before.\"],\n        [\"history\", \"Most likely someone you've never heard of. If you have interacted, that counts.\"],\n        [\"poster\", \"How often people have interacted with them in the past few weeks.\"]\n      ],\n      follow: false, notFollow: true,\n      pool: \"Recommendations from accounts you don't yet follow.\",\n      acts: [\"Like\", \"Save\", \"Share\"],\n      note: \"Source: Instagram, Instagram Ranking Explained, May 2023.\"\n    },\n    reels: {\n      ranked: true,\n      order: [\n        [\"activity\", \"Reels you've liked, saved, reshared, commented on and engaged with recently.\"],\n        [\"history\", \"Likely someone you've never heard of. If you have interacted, that counts.\"],\n        [\"post\", \"The audio track and visuals in the video, plus its popularity.\", \"Information about the reel\"],\n        [\"poster\", \"Popularity, like number of followers or level of engagement.\"]\n      ],\n      follow: false, notFollow: true,\n      pool: \"Mostly accounts you don't follow.\",\n      acts: [\"Reshare\", \"Watch to the end\", \"Like\", \"Open the audio page\"],\n      note: \"Source: Instagram, Instagram Ranking Explained, May 2023.\"\n    }\n  };\n  var KEYS = [\"feed\", \"stories\", \"explore\", \"reels\"];\n  var reduce = window.matchMedia && matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n  var list = document.getElementById(\"list\");\n  var buttons = Array.prototype.slice.call(document.querySelectorAll(\".seg button\"));\n  var cards = {};\n\n  Object.keys(SIGNALS).forEach(function (key) {\n    var li = document.createElement(\"li\");\n    li.className = \"card\";\n    li.hidden = true;\n    li.innerHTML = '<span class=\"n\" aria-hidden=\"true\"></span><span><span class=\"t\"></span><span class=\"d\"></span></span>';\n    list.appendChild(li);\n    cards[key] = li;\n  });\n\n  function setText(id, text) { document.getElementById(id).textContent = text; }\n\n  function apply(surface) {\n    var s = SURFACES[surface];\n    var shown = {};\n    s.order.forEach(function (entry, i) {\n      var li = cards[entry[0]];\n      shown[entry[0]] = true;\n      li.hidden = false;\n      li.style.order = i;\n      li.className = \"card\" + (s.ranked ? \"\" : \" unranked\") + (s.ranked && i === 0 ? \" top1\" : \"\");\n      li.querySelector(\".n\").textContent = s.ranked ? String(i + 1) : \"•\";\n      var title = li.querySelector(\".t\");\n      title.textContent = entry[2] || SIGNALS[entry[0]];\n      if (s.ranked && i === 0) {\n        var badge = document.createElement(\"span\");\n        badge.className = \"badge\";\n        badge.textContent = \"First\";\n        title.appendChild(badge);\n      }\n      li.querySelector(\".d\").textContent = entry[1];\n    });\n    Object.keys(cards).forEach(function (key) { if (!shown[key]) cards[key].hidden = true; });\n    setText(\"kicker\", s.ranked ? \"Ranked, roughly by importance\" : \"Stories signals, no order given\");\n    setText(\"pool\", s.pool);\n    setText(\"note\", s.note);\n    document.getElementById(\"pf\").className = s.follow ? \"on\" : \"\";\n    document.getElementById(\"pn\").className = s.notFollow ? \"on\" : \"\";\n    var acts = document.getElementById(\"acts\");\n    acts.textContent = \"\";\n    s.acts.forEach(function (a) { var li = document.createElement(\"li\"); li.textContent = a; acts.appendChild(li); });\n    buttons.forEach(function (b) {\n      var on = b.getAttribute(\"data-s\") === surface;\n      b.setAttribute(\"aria-checked\", on ? \"true\" : \"false\");\n      b.tabIndex = on ? 0 : -1;\n    });\n  }\n\n  var current = \"feed\";\n  function select(surface, focus) {\n    if (surface === current && !focus) return;\n    var before = {};\n    Object.keys(cards).forEach(function (k) { if (!cards[k].hidden) before[k] = cards[k].getBoundingClientRect(); });\n    current = surface;\n    apply(surface);\n    if (focus) buttons[KEYS.indexOf(surface)].focus();\n    if (reduce || !cards.activity.animate) return;\n    Object.keys(cards).forEach(function (k) {\n      var li = cards[k];\n      if (li.hidden) return;\n      var after = li.getBoundingClientRect();\n      if (before[k]) {\n        var dy = before[k].top - after.top;\n        if (Math.abs(dy) > 0.5) li.animate([{ transform: \"translateY(\" + dy + \"px)\" }, { transform: \"none\" }], { duration: 460, easing: \"cubic-bezier(.2,.8,.2,1)\" });\n      } else {\n        li.animate([{ opacity: 0, transform: \"translateY(10px)\" }, { opacity: 1, transform: \"none\" }], { duration: 360, easing: \"ease-out\", delay: 60 * Number(li.style.order), fill: \"backwards\" });\n      }\n    });\n  }\n\n  // Hold the list at its tallest surface so switching never makes the page jump.\n  function settle() {\n    list.style.minHeight = \"\";\n    // Stacked on a phone, the panel sits below the list; a held gap there would read as broken.\n    if (innerWidth <= 720) { apply(current); return; }\n    var tallest = 0;\n    KEYS.forEach(function (k) { apply(k); tallest = Math.max(tallest, list.getBoundingClientRect().height); });\n    apply(current);\n    list.style.minHeight = Math.ceil(tallest) + \"px\";\n  }\n\n  buttons.forEach(function (b, i) {\n    b.addEventListener(\"click\", function () { select(b.getAttribute(\"data-s\"), false); });\n    b.addEventListener(\"keydown\", function (e) {\n      var next = null;\n      if (e.key === \"ArrowRight\" || e.key === \"ArrowDown\") next = (i + 1) % 4;\n      else if (e.key === \"ArrowLeft\" || e.key === \"ArrowUp\") next = (i + 3) % 4;\n      else if (e.key === \"Home\") next = 0;\n      else if (e.key === \"End\") next = 3;\n      if (next !== null) { e.preventDefault(); select(KEYS[next], true); }\n    });\n  });\n\n  settle();\n  var width = innerWidth;\n  addEventListener(\"resize\", function () { if (innerWidth !== width) { width = innerWidth; settle(); } });\n})();\n</script>\n",
