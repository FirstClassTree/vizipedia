    {
      "kind": "figure",
      "heading": "The four rules and three kinds of pattern",
      "body": "<style>\n.lr{box-sizing:border-box;max-width:1040px;margin:0 auto;font-family:var(--ow-font);color:var(--ow-fg);display:grid;gap:18px}\n.lr-rules{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(170px,1fr))}\n.lr-card{padding:14px;border-radius:14px;background:var(--ow-panel);border:1px solid var(--ow-line);display:grid;gap:8px}\n.lr-card b{font-size:15px}\n.lr-card svg{width:100%;max-width:200px;height:auto}\n.lr-card span,.lr-p span{font-size:13.5px;line-height:1.35;color:var(--ow-muted)}\n.lr .on{fill:var(--ow-accent)}\n.lr .off{fill:none;stroke:var(--ow-line);stroke-width:1.2}\n.lr .c{stroke:var(--ow-fg);stroke-width:2}\n.lr .ar{fill:none;stroke:var(--ow-muted);stroke-width:2;stroke-linecap:round;stroke-linejoin:round}\n.lr-h{margin:0;font-size:13px;font-weight:650;letter-spacing:.06em;text-transform:uppercase;color:var(--ow-muted)}\n.lr-pats{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(150px,1fr))}\n.lr-p{padding:14px;border-radius:14px;background:var(--ow-panel);border:1px solid var(--ow-line);display:grid;gap:4px;justify-items:start}\n.lr-p svg{margin-bottom:6px}\n</style>\n<div class=\"lr\" role=\"img\" aria-label=\"The four rules of Conway's Game of Life shown on 3 by 3 neighbourhoods, and one example each of a still life, an oscillator and a spaceship\">\n<div class=\"lr-rules\"><div class=\"lr-card\"><b>Underpopulation</b><svg viewBox=\"0 0 144 54\" aria-hidden=\"true\"><rect class=\"on\" x=\"0\" y=\"0\" width=\"16\" height=\"16\" rx=\"3\"/><rect class=\"off\" x=\"18\" y=\"0\" width=\"16\" height=\"16\" rx=\"3\"/><rect class=\"off\" x=\"36\" y=\"0\" width=\"16\" height=\"16\" rx=\"3\"/><rect class=\"off\" x=\"0\" y=\"18\" width=\"16\" height=\"16\" rx=\"3\"/><rect class=\"on c\" x=\"18\" y=\"18\" width=\"16\" height=\"16\" rx=\"3\"/><rect class=\"off\" x=\"36\" y=\"18\" width=\"16\" height=\"16\" rx=\"3\"/><rect class=\"off\" x=\"0\" y=\"36\" width=\"16\" height=\"16\" rx=\"3\"/><rect class=\"off\" x=